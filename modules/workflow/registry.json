{
  "schemaVersion": 1,
  "flows": [
    {
      "id": "prototype",
      "title": "原型、问题与需求",
      "entry": "flows/prototype/entry.md",
      "commands": [
        "prototype"
      ],
      "start": "prototype status --json",
      "resume": "prototype next --limit 10 --json",
      "outputs": [
        "prototype/catalog.sqlite",
        "prototype/analyses/"
      ],
      "handoff": "planning",
      "goal": {
        "mode": "analyze",
        "allowedWrites": [
          "prototype/"
        ],
        "completion": "只补充到保存结束；分析到审计、人工复核及接受"
      }
    },
    {
      "id": "prd",
      "title": "PRD 阅读与取证",
      "entry": "flows/prd/entry.md",
      "commands": [
        "prd"
      ],
      "start": "prd status --json",
      "resume": "prd status --json",
      "outputs": [
        "prd/manifest.json",
        "prd/sources/",
        "prd/analyses/"
      ],
      "handoff": "planning",
      "goal": {
        "mode": "analyze",
        "allowedWrites": [
          "prd/"
        ],
        "completion": "来源冻结且 findings.json 通过 check 后 render 会议材料；PRD 只读，不授权开发"
      }
    },
    {
      "id": "planning",
      "title": "功能规划与变更复评",
      "entry": "flows/planning/entry.md",
      "commands": [
        "feature",
        "graph"
      ],
      "start": "graph sync --json",
      "resume": "run context --id <ID>",
      "outputs": [
        "planning/feature-map.json",
        "refinement-runs/"
      ],
      "handoff": "delivery",
      "goal": {
        "mode": "plan",
        "allowedWrites": [
          "planning/",
          "graph/",
          "refinement-runs/"
        ],
        "completion": "发布通过复评的功能地图"
      }
    },
    {
      "id": "delivery",
      "title": "产品交付与回归",
      "entry": "flows/delivery/entry.md",
      "commands": [
        "delivery",
        "work",
        "visual",
        "api-mock",
        "miniapp",
        "gate"
      ],
      "start": "feature status",
      "resume": "work delivery-brief --run <ID> --task <ID>",
      "outputs": [
        "delivery-runs/",
        "planning/feature-history.json"
      ],
      "handoff": "prototype",
      "goal": {
        "mode": "deliver",
        "allowedWrites": [
          "任务声明的代码根与写范围",
          "delivery-runs/",
          "planning/feature-history.json"
        ],
        "completion": "任务、合并验证与运行均完成"
      }
    },
    {
      "id": "system",
      "title": "外部系统事实",
      "entry": "flows/system/entry.md",
      "commands": [
        "system"
      ],
      "start": "system status",
      "resume": "run context --id <ID>",
      "outputs": [
        "system/cards.json",
        "system-runs/"
      ],
      "handoff": "planning",
      "goal": {
        "mode": "verify_system",
        "allowedWrites": [
          "system/",
          "system-runs/"
        ],
        "completion": "发布已核验系统结论；外部系统只读"
      }
    },
    {
      "id": "project",
      "title": "项目与环境登记",
      "entry": "flows/project/entry.md",
      "commands": [
        "init",
        "project"
      ],
      "start": "project status",
      "resume": "project status",
      "outputs": [
        "project.json",
        "projects/"
      ],
      "handoff": "planning",
      "goal": {
        "mode": "register_project",
        "allowedWrites": [
          "project.json",
          "projects/"
        ],
        "completion": "登记与当前范围的环境核验完成"
      }
    },
    {
      "id": "overview",
      "title": "上下文与看板",
      "entry": "flows/overview/entry.md",
      "commands": [
        "current",
        "dashboard",
        "run",
        "check",
        "compact",
        "tasktype",
        "graph",
        "capability",
        "kernel"
      ],
      "start": "flow route --json",
      "resume": "run context --id <ID>",
      "outputs": [],
      "handoff": null,
      "goal": {
        "mode": "inspect",
        "allowedWrites": [],
        "completion": "返回所需分页信息；重建需明确请求"
      }
    },
    {
      "id": "maintenance",
      "title": "技能与流程工具维护",
      "entry": "flows/maintenance/entry.md",
      "commands": [],
      "start": null,
      "resume": null,
      "outputs": [],
      "handoff": null,
      "goal": {
        "mode": "maintain",
        "allowedWrites": [
          ".codex/skills/mf-dev-flow/",
          ".codex/hooks.json",
          "隔离 fixture"
        ],
        "completion": "工具修改与隔离验证完成；不进入真实产品流程"
      }
    }
  ],
